{
  "manifest_version": 3,
  "name": "EdgeBar - Minimal Web Panels",
  "version": "1.0.0",
  "description": "Ultra-minimal, collapsible side dock & slide-out web panels for Gemini, ChatGPT, X, and your custom shortcuts.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EdgeBar'ı Aç / Kapat"
  },
  "commands": {
    "toggle-edgebar": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "EdgeBar'ı Aç / Kapat"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_iframe_bypass",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
