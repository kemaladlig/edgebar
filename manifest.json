{
  "manifest_version": 3,
  "name": "EdgeBar - In-Browser Workspace & AI Companion",
  "version": "1.1.0",
  "description": "Arc & Raycast inspired vertical dock, closable tabs, address bar and slide-out workspace for Gemini, ChatGPT, and your custom web apps.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EdgeBar'ı Aç / Kapat"
  },
  "commands": {
    "toggle-edgebar": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "EdgeBar'ı Aç / Kapat"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_iframe_bypass",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
